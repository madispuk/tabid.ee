---
layout: layout.liquid
pagination:
  data: collections.artists
  size: 1
  alias: artistData
permalink: "/artist/{{ artistData.artist | artistSlug }}/"
eleventyComputed:
  pageTitle: "{{ artistData.artist }} akordid | tabid.ee"
  metaDescription: "{{ artistData.artist }} laulude akordid ja sõnad kitarrile. {{ artistData.songs.length }} laulu tabid.ee lehel."
---

<div class="mb-6">
  <a href="/" class="inline-flex items-center gap-1 text-sm text-ctp-overlay1 hover:text-ctp-lavender transition-colors mb-4">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m15 19-7-7 7-7"/></svg>
    Tagasi
  </a>

  <h1 class="text-2xl md:text-3xl font-bold text-ctp-text mb-1">{{ artistData.artist }}</h1>
  <p class="text-sm text-ctp-overlay1">{{ artistData.songs.size }} laulu</p>
</div>

<div class="space-y-2">
  {%- for item in artistData.songs %}
  <a href="/laulud/{{ item.data.slug }}/" class="flex items-center justify-between py-2 px-3 rounded-lg border border-ctp-surface0 bg-ctp-mantle text-ctp-subtext1 hover:border-ctp-mauve/40 hover:text-ctp-mauve transition-all">
    <span class="truncate">{{ item.data.song }}</span>
  </a>
  {%- endfor %}
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MusicGroup",
  "name": "{{ artistData.artist }}",
  "url": "https://tabid.ee/artist/{{ artistData.artist | artistSlug }}/"
}
</script>
