---
layout: layout.liquid
pageTitle: "Eesti laulude akordid | tabid.ee"
metaDescription: "Eesti laulude akordid ja sõnad kitarrile. Leia oma lemmiklaulu akordid tabid.ee lehelt."
---

<div class="flex items-center justify-between mb-4 gap-2">
  <h1 class="text-lg font-bold text-ctp-text min-w-0 truncate">Eesti laulude akordid</h1>
  <div class="flex items-center gap-2 flex-shrink-0">
    <a href="/tuner/" class="p-1.5 rounded-lg text-ctp-overlay1 hover:text-ctp-text hover:bg-ctp-surface0 transition-colors" title="Kitarri häälestaja">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M8 2v9a4 4 0 0 0 8 0V2M12 16v6"/>
      </svg>
    </a>
    <a href="/lisa/" class="px-4 py-1.5 text-xs rounded-lg font-medium bg-ctp-surface0 text-ctp-subtext0 hover:bg-ctp-mauve hover:text-ctp-crust transition-colors whitespace-nowrap">Lisa laul</a>
  </div>
</div>

<div class="mb-8 space-y-3">
  <div class="relative">
    <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-ctp-overlay0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
    </svg>
    <input
      type="text"
      id="search"
      placeholder="Otsi laulu või artisti..."
      class="w-full pl-10 pr-4 py-2.5 text-base sm:text-sm rounded-xl border border-ctp-surface1 bg-ctp-mantle text-ctp-text placeholder-ctp-overlay0 focus:outline-none focus:ring-2 focus:ring-ctp-mauve focus:border-transparent"
      autocomplete="off"
    >
  </div>

  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2">
      <button id="filter-all" class="filter-btn px-4 py-1.5 text-xs rounded-lg font-medium bg-ctp-mauve text-ctp-crust">Kõik</button>
      <button id="filter-chords" class="filter-btn px-4 py-1.5 text-xs rounded-lg font-medium bg-ctp-surface0 text-ctp-subtext0 hover:bg-ctp-surface1">Akordid</button>
      <button id="filter-tabs" class="filter-btn px-4 py-1.5 text-xs rounded-lg font-medium bg-ctp-surface0 text-ctp-subtext0 hover:bg-ctp-surface1">Tabulatuurid</button>
      <span class="w-px h-5 bg-ctp-surface1"></span>
      <button id="toggle-beginner" class="flex items-center gap-1.5 px-4 py-1.5 text-xs rounded-lg font-medium
        bg-ctp-surface0 text-ctp-subtext0 hover:bg-ctp-surface1 transition-colors" title="Lihtsad akordid: C, G, D, Am,
        Em...">Algajale <span id="beginner-dot" class="w-1.5 h-1.5 rounded-full bg-ctp-overlay0"></span></button>
      <span class="hidden sm:block w-px h-5 bg-ctp-surface1"></span>
      <span id="results-count" class="hidden sm:inline text-xs text-ctp-overlay1"></span>
    </div>
    <button id="layout-toggle" class="hidden sm:block p-1.5 rounded-lg text-ctp-overlay1 hover:text-ctp-text hover:bg-ctp-surface0 transition-colors" title="Vaheta veerge">
      <svg id="icon-multi" class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor"><rect x="0" y="0" width="4" height="16" rx="1"/><rect x="6" y="0" width="4" height="16" rx="1"/><rect x="12" y="0" width="4" height="16" rx="1"/></svg>
      <svg id="icon-single" class="w-4 h-4 hidden" viewBox="0 0 16 16" fill="currentColor"><rect x="0" y="0" width="16" height="16" rx="1"/></svg>
    </button>
  </div>
</div>

<div id="song-list" class="columns-1 sm:columns-2 lg:columns-3 gap-x-16">
  {%- assign grouped = collections.songs | groupByArtist %}
  {%- for group in grouped %}
  <div class="artist-group break-inside-avoid mb-4" data-artist="{{ group.artist }}">
    <h2 class="text-xs font-bold uppercase tracking-wide text-ctp-lavender border-b border-ctp-surface0 pb-1 mb-1"><a href="/artist/{{ group.artist | artistSlug }}/" class="hover:underline">{{ group.artist | default: "Tundmatu" }}</a></h2>
    <ul>
      {%- for item in group.songs %}
      {%- assign diff = item.content | songDifficulty %}
      <li class="song-item" data-title="{{ item.data.song | downcase }}" data-artist="{{ item.data.artist | downcase }}" data-tabs="{{ item.data.hasTabs }}" data-difficulty="{{ diff }}">
        <a href="/laulud/{{ item.data.slug }}/" class="flex items-center justify-between py-px px-1 text-sm leading-snug rounded hover:bg-ctp-surface0 text-ctp-subtext1 hover:text-ctp-mauve"><span class="truncate">{{ item.data.song }}</span></a>
      </li>
      {%- endfor %}
    </ul>
  </div>
  {%- endfor %}
</div>

<div id="no-results" class="hidden py-12 text-center text-ctp-overlay1">
  <p class="text-lg">Ei leidnud &uuml;htegi laulu</p>
  <p class="text-sm mt-1">Proovi teist otsingut</p>
</div>

<script src="{{ "/js/index-page.js" | cacheBust }}"></script>
