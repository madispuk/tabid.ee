---
layout: layout.njk
pagination:
  data: songs
  size: 1
  alias: song
permalink: "laulud/{{ song.slug }}/"
eleventyComputed:
  pageTitle: "{{ song.title }} — Kitarr"
---

<div class="mb-6">
  <a href="/" class="inline-flex items-center gap-1 text-sm text-ctp-overlay1 hover:text-ctp-lavender transition-colors mb-4">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m15 19-7-7 7-7"/></svg>
    Tagasi
  </a>

  <h1 class="text-2xl md:text-3xl font-bold text-ctp-text mb-1">{{ song.song }}</h1>
  {% if song.artist %}
  <p class="text-lg text-ctp-mauve">
{{ song.artist }}
  </p>
  {% endif %}
</div>

{# ─── Chord Summary Strip ─── #}
<div id="chord-strip" class="mb-4 hidden">
  <div class="flex items-center gap-2 mb-2">
    <span class="text-xs text-ctp-overlay0 font-medium uppercase tracking-wider">Akordid laulus</span>
    <span id="capo-hint" class="text-xs text-ctp-green hidden"></span>
  </div>
  <div id="chord-strip-items" class="flex flex-wrap gap-2"></div>
  <div id="power-strip" class="mt-3 hidden">
    <span class="text-xs text-ctp-overlay0 font-medium uppercase tracking-wider mb-2 block">Power akordid</span>
    <div id="power-strip-items" class="flex flex-wrap gap-2"></div>
  </div>
</div>

<div class="song-sheet relative rounded-xl border border-ctp-surface0 bg-ctp-mantle overflow-hidden">
  <div class="flex items-center justify-between px-4 py-2 border-b border-ctp-surface0 bg-ctp-crust/50">
    <div class="flex items-center gap-3">
      <span class="text-xs text-ctp-overlay0 font-medium uppercase tracking-wider">Akordid & s&otilde;nad</span>
      <span id="original-key" class="text-xs text-ctp-overlay1 hidden"></span>
    </div>
    <div class="flex items-center gap-2">
      {# Auto-scroll controls #}
      <div class="flex items-center gap-1">
        <button id="scroll-btn" class="text-xs text-ctp-overlay1 hover:text-ctp-text px-2 py-1 rounded transition-colors" title="Automaatne kerimine (Space)">
          <svg id="scroll-play" class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.84A1.5 1.5 0 004 4.11v11.78a1.5 1.5 0 002.3 1.27l9.344-5.891a1.5 1.5 0 000-2.538L6.3 2.841z"/></svg>
          <svg id="scroll-pause" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 20 20"><path d="M5.75 3a.75.75 0 00-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 00.75-.75V3.75A.75.75 0 007.25 3h-1.5zM12.75 3a.75.75 0 00-.75.75v12.5c0 .414.336.75.75.75h1.5a.75.75 0 00.75-.75V3.75a.75.75 0 00-.75-.75h-1.5z"/></svg>
        </button>
        <input id="scroll-speed" type="range" min="1" max="10" value="3" class="w-16 h-1 accent-ctp-mauve hidden" title="Kiirus">
      </div>
      <select id="transpose-select" class="hidden text-xs bg-ctp-surface0 text-ctp-text border border-ctp-surface1 rounded px-2 py-1 cursor-pointer focus:outline-none focus:ring-1 focus:ring-ctp-lavender" title="Transponeeri"></select>
      <button id="font-size-toggle" class="text-xs text-ctp-overlay1 hover:text-ctp-text px-2 py-1 rounded transition-colors" title="Muuda fondi suurust">
        aA
      </button>
    </div>
  </div>
  <pre id="song-content" class="song-pre p-4 md:p-6 overflow-x-auto text-sm md:text-base font-mono leading-relaxed text-ctp-subtext1">{{ song.content }}</pre>
</div>

{% set artistSongs = songs | artistSongs(song.artist) %}
{% if artistSongs.length > 1 %}
<div class="mt-8">
  <h2 class="text-lg font-semibold mb-3 text-ctp-subtext1">Veel artisti {{ song.artist }} laule</h2>
  <ul class="space-y-1">
    {% for s in artistSongs %}
    {% if s.slug !== song.slug %}
    <li>
      <a href="/laulud/{{ s.slug }}/" class="block px-3 py-2 rounded-lg hover:bg-ctp-surface0 text-ctp-subtext0 hover:text-ctp-mauve transition-colors">
        {{ s.song }}
      </a>
    </li>
    {% endif %}
    {% endfor %}
  </ul>
</div>
{% endif %}

{# ─── Chord Popup ─── #}
<div id="chord-popup" class="fixed z-50 hidden">
  <div class="bg-ctp-crust border border-ctp-surface1 rounded-xl shadow-2xl p-3 max-w-[420px]">
    <div class="flex items-center justify-between mb-2">
      <span id="popup-chord-name" class="text-sm font-bold text-ctp-mauve"></span>
      <button id="popup-close" class="text-ctp-overlay0 hover:text-ctp-text text-xs px-1">&times;</button>
    </div>
    <div id="popup-voicings" class="flex gap-2 overflow-x-auto pb-1"></div>
    <div class="flex items-center gap-2 mt-2">
      <div class="flex gap-1" id="popup-dots"></div>
      <span class="text-[10px] text-ctp-overlay0 ml-auto">lihtne → keeruline</span>
    </div>
  </div>
</div>

<script src="/js/chords.js"></script>
<script src="/js/chord-svg.js"></script>
<script>
(function() {
  const pre = document.getElementById('song-content');

  // ─── Font size toggle ───
  const fontBtn = document.getElementById('font-size-toggle');
  const sizes = ['text-xs', 'text-sm', 'text-base', 'text-lg'];
  let currentSize = parseInt(localStorage.getItem('songFontSize') || '1');

  function applySize() {
    sizes.forEach(s => pre.classList.remove(s));
    pre.classList.add(sizes[currentSize]);
    pre.classList.remove('md:text-base', 'md:text-lg', 'md:text-xl');
  }

  fontBtn.addEventListener('click', () => {
    currentSize = (currentSize + 1) % sizes.length;
    localStorage.setItem('songFontSize', currentSize);
    applySize();
  });
  applySize();

  // ─── Transpose ───
  const NOTES_SHARP = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
  const NOTES_FLAT  = ['C', 'Db', 'D', 'Eb', 'E', 'F', 'Gb', 'G', 'Ab', 'A', 'Bb', 'B'];
  const CHORD_RE = /\b([A-G][#b]?)(m|min|maj|dim|aug|sus[24]?|add)?(\d+)?(\/[A-G][#b]?)?\b/g;

  function noteToIndex(note) {
    let idx = NOTES_SHARP.indexOf(note);
    if (idx === -1) idx = NOTES_FLAT.indexOf(note);
    return idx;
  }

  function transposeNote(note, semitones, useFlats) {
    const idx = noteToIndex(note);
    if (idx === -1) return note;
    const newIdx = ((idx + semitones) % 12 + 12) % 12;
    return useFlats ? NOTES_FLAT[newIdx] : NOTES_SHARP[newIdx];
  }

  function transposeChord(match, root, quality, ext, bass, semitones, useFlats) {
    let result = transposeNote(root, semitones, useFlats);
    if (quality) result += quality;
    if (ext) result += ext;
    if (bass) {
      const bassNote = bass.slice(1);
      result += '/' + transposeNote(bassNote, semitones, useFlats);
    }
    return result;
  }

  function isChordLine(line) {
    const stripped = line.trim();
    if (!stripped) return false;
    const withoutChords = stripped.replace(CHORD_RE, '').replace(/[\s|,.\-–—:x\d()\/\[\]]/g, '');
    return withoutChords.length <= stripped.length * 0.3;
  }

  function usesFlats(text) {
    const flatCount = (text.match(/[A-G]b/g) || []).length;
    const sharpCount = (text.match(/[A-G]#/g) || []).length;
    return flatCount > sharpCount;
  }

  function detectKey(text) {
    const lines = text.split('\n');
    for (const line of lines) {
      if (!isChordLine(line)) continue;
      CHORD_RE.lastIndex = 0;
      const m = CHORD_RE.exec(line.trim());
      if (m) return m[1] + (m[2] || '');
    }
    return null;
  }

  function transposeLine(line, semitones, flats) {
    if (!isChordLine(line)) return line;
    CHORD_RE.lastIndex = 0;
    const matches = [...line.matchAll(CHORD_RE)];
    if (!matches.length) return line;

    let result = line;
    for (let i = matches.length - 1; i >= 0; i--) {
      const m = matches[i];
      const original = m[0];
      const transposed = transposeChord(m[0], m[1], m[2], m[3], m[4], semitones, flats);
      const start = m.index;
      const end = start + original.length;
      const diff = transposed.length - original.length;
      result = result.slice(0, start) + transposed + result.slice(end);
      if (diff > 0) {
        const afterPos = start + transposed.length;
        let spacesToEat = 0;
        while (spacesToEat < diff && result[afterPos + spacesToEat] === ' ') spacesToEat++;
        if (spacesToEat > 0) result = result.slice(0, afterPos) + result.slice(afterPos + spacesToEat);
      } else if (diff < 0) {
        const afterPos = start + transposed.length;
        result = result.slice(0, afterPos) + ' '.repeat(-diff) + result.slice(afterPos);
      }
    }
    return result;
  }

  // Extract chords from content
  function extractChords(text) {
    const chords = [];
    const seen = new Set();
    const lines = text.split('\n');
    for (const line of lines) {
      if (!isChordLine(line)) continue;
      CHORD_RE.lastIndex = 0;
      let m;
      while ((m = CHORD_RE.exec(line)) !== null) {
        const chord = m[0];
        if (!seen.has(chord)) {
          seen.add(chord);
          chords.push(chord);
        }
      }
    }
    return chords;
  }

  const originalContent = pre.textContent;
  const originalKey = detectKey(originalContent);
  const flats = usesFlats(originalContent);
  let semitones = 0;

  const select = document.getElementById('transpose-select');
  const keyDisplay = document.getElementById('original-key');

  if (originalKey) {
    select.classList.remove('hidden');
    keyDisplay.classList.remove('hidden');
    keyDisplay.textContent = 'Orig: ' + originalKey;

    const rootNote = originalKey.replace(/m$|min$|maj$|dim$|aug$|sus[24]?$|add\d*$/, '');
    const suffix = originalKey.replace(/^[A-G][#b]?/, '');
    const notes = flats ? NOTES_FLAT : NOTES_SHARP;

    for (let i = 0; i < 12; i++) {
      const opt = document.createElement('option');
      opt.value = i;
      const targetRoot = transposeNote(rootNote, i, flats);
      const targetKey = targetRoot + suffix;
      opt.textContent = i === 0 ? targetKey + ' (orig)' : targetKey;
      select.appendChild(opt);
    }
  }

  function getCurrentContent() {
    if (semitones === 0) return originalContent;
    const lines = originalContent.split('\n');
    return lines.map(l => transposeLine(l, semitones, flats)).join('\n');
  }

  function applyTranspose() {
    pre.textContent = getCurrentContent();
    makechordsClickable();
    updateChordStrip();
    updateCapoHint();
  }

  select.addEventListener('change', () => {
    semitones = parseInt(select.value);
    applyTranspose();
  });

  // ─── Chord Popup ───
  const popup = document.getElementById('chord-popup');
  const popupName = document.getElementById('popup-chord-name');
  const popupVoicings = document.getElementById('popup-voicings');
  const popupDots = document.getElementById('popup-dots');
  const popupClose = document.getElementById('popup-close');

  function showChordPopup(chordName, anchorEl) {
    const db = window.CHORD_DB;
    // Normalize chord name: try exact, then without bass note
    let voicings = db[chordName];
    if (!voicings) {
      // Try base chord without slash bass
      const baseName = chordName.replace(/\/[A-G][#b]?$/, '');
      voicings = db[baseName];
    }
    if (!voicings || !voicings.length) return;

    popupName.textContent = chordName;
    popupVoicings.innerHTML = '';
    popupDots.innerHTML = '';

    voicings.forEach((v, i) => {
      const div = document.createElement('div');
      div.className = 'flex-shrink-0';
      div.innerHTML = ChordSVG.render(v, `#${i+1}`, { width: 90, height: 116 });
      popupVoicings.appendChild(div);

      // Dot indicator
      const dot = document.createElement('div');
      dot.className = `w-1.5 h-1.5 rounded-full ${i === 0 ? 'bg-ctp-mauve' : 'bg-ctp-surface1'}`;
      popupDots.appendChild(dot);
    });

    popup.classList.remove('hidden');

    // Position popup near the anchor
    const rect = anchorEl.getBoundingClientRect();
    const popupEl = popup.firstElementChild;
    popup.style.left = Math.max(8, Math.min(rect.left, window.innerWidth - 440)) + 'px';

    // Show above or below depending on space
    const spaceBelow = window.innerHeight - rect.bottom;
    if (spaceBelow > 160) {
      popup.style.top = (rect.bottom + window.scrollY + 4) + 'px';
    } else {
      popup.style.top = (rect.top + window.scrollY - 140) + 'px';
    }
  }

  popupClose.addEventListener('click', () => popup.classList.add('hidden'));
  document.addEventListener('click', (e) => {
    if (!popup.contains(e.target) && !e.target.classList.contains('chord-link') && !e.target.closest('.chord-strip-btn')) {
      popup.classList.add('hidden');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') popup.classList.add('hidden');
  });

  // Hide popup when mouse leaves both the trigger and the popup
  let hideTimeout = null;
  function scheduleHide() {
    hideTimeout = setTimeout(() => popup.classList.add('hidden'), 200);
  }
  function cancelHide() {
    if (hideTimeout) { clearTimeout(hideTimeout); hideTimeout = null; }
  }
  popup.addEventListener('mouseenter', cancelHide);
  popup.addEventListener('mouseleave', scheduleHide);

  // ─── Make chords clickable ───
  function makechordsClickable() {
    const text = pre.textContent;
    const lines = text.split('\n');
    const fragment = document.createDocumentFragment();

    lines.forEach((line, lineIdx) => {
      if (lineIdx > 0) fragment.appendChild(document.createTextNode('\n'));

      if (!isChordLine(line)) {
        fragment.appendChild(document.createTextNode(line));
        return;
      }

      CHORD_RE.lastIndex = 0;
      let lastIndex = 0;
      let m;
      while ((m = CHORD_RE.exec(line)) !== null) {
        // Text before chord
        if (m.index > lastIndex) {
          fragment.appendChild(document.createTextNode(line.slice(lastIndex, m.index)));
        }
        // Chord span
        const span = document.createElement('span');
        span.textContent = m[0];
        span.className = 'chord-link cursor-pointer text-ctp-mauve hover:text-ctp-pink hover:underline';
        span.dataset.chord = m[0];
        span.addEventListener('click', (e) => {
          e.stopPropagation();
          showChordPopup(span.dataset.chord, span);
        });
        span.addEventListener('mouseenter', () => {
          cancelHide();
          showChordPopup(span.dataset.chord, span);
        });
        span.addEventListener('mouseleave', scheduleHide);
        fragment.appendChild(span);
        lastIndex = m.index + m[0].length;
      }
      if (lastIndex < line.length) {
        fragment.appendChild(document.createTextNode(line.slice(lastIndex)));
      }
    });

    pre.innerHTML = '';
    pre.appendChild(fragment);
  }

  // ─── Chord Summary Strip ───
  const chordStrip = document.getElementById('chord-strip');
  const chordStripItems = document.getElementById('chord-strip-items');

  const powerStrip = document.getElementById('power-strip');
  const powerStripItems = document.getElementById('power-strip-items');

  function updateChordStrip() {
    const content = getCurrentContent();
    const chords = extractChords(content);
    if (chords.length === 0) {
      chordStrip.classList.add('hidden');
      return;
    }

    chordStrip.classList.remove('hidden');
    chordStripItems.innerHTML = '';

    const db = window.CHORD_DB;
    const powerChordRoots = new Set();

    chords.forEach(chord => {
      const voicings = db[chord] || db[chord.replace(/\/[A-G][#b]?$/, '')];
      const btn = document.createElement('button');
      btn.className = 'chord-strip-btn flex flex-col items-center gap-1 p-1.5 rounded-lg bg-ctp-surface0 hover:bg-ctp-surface1 transition-colors';
      btn.title = chord;

      if (voicings && voicings.length > 0) {
        btn.innerHTML = ChordSVG.render(voicings[0], chord, { width: 60, height: 76, mini: true })
          + `<span class="text-[11px] font-semibold text-ctp-subtext1 font-mono">${chord}</span>`;
      } else {
        btn.innerHTML = `<span class="text-xs text-ctp-subtext0 font-mono px-2 py-4">${chord}</span>`;
      }

      btn.addEventListener('click', () => showChordPopup(chord, btn));
      chordStripItems.appendChild(btn);

      // Collect root notes for power chords
      CHORD_RE.lastIndex = 0;
      const m = CHORD_RE.exec(chord);
      if (m) powerChordRoots.add(m[1]);
    });

    // Build power chord strip
    powerStripItems.innerHTML = '';
    const powerChords = [];
    for (const root of powerChordRoots) {
      const powerName = root + '5';
      if (db[powerName]) powerChords.push(powerName);
    }

    if (powerChords.length > 0) {
      powerStrip.classList.remove('hidden');
      powerChords.forEach(pc => {
        const voicings = db[pc];
        const btn = document.createElement('button');
        btn.className = 'chord-strip-btn flex flex-col items-center gap-1 p-1.5 rounded-lg bg-ctp-surface0 hover:bg-ctp-surface1 transition-colors';
        btn.title = pc;
        btn.innerHTML = ChordSVG.render(voicings[0], pc, { width: 60, height: 76, mini: true })
          + `<span class="text-[11px] font-semibold text-ctp-subtext1 font-mono">${pc}</span>`;
        btn.addEventListener('click', () => showChordPopup(pc, btn));
        powerStripItems.appendChild(btn);
      });
    } else {
      powerStrip.classList.add('hidden');
    }
  }

  // ─── Capo Calculator ───
  const capoHint = document.getElementById('capo-hint');
  const BEGINNER_OPEN = new Set(['C','D','E','G','A','Am','Dm','Em','C7','D7','E7','G7','A7','B7','Am7','Em7','Dm7']);

  function chordDifficultyScore(chords) {
    let score = 0;
    for (const c of chords) {
      if (BEGINNER_OPEN.has(c)) score += 0;
      else score += 1;
    }
    return score;
  }

  function updateCapoHint() {
    const content = getCurrentContent();
    const currentChords = extractChords(content);
    if (currentChords.length === 0) return;

    const currentScore = chordDifficultyScore(currentChords);
    if (currentScore === 0) {
      capoHint.classList.add('hidden');
      return;
    }

    let bestCapo = 0;
    let bestScore = currentScore;
    let bestChords = currentChords;

    for (let capo = 1; capo <= 11; capo++) {
      const transposed = currentChords.map(c => {
        CHORD_RE.lastIndex = 0;
        const m = CHORD_RE.exec(c);
        if (!m) return c;
        return transposeChord(c, m[1], m[2], m[3], m[4], -capo, flats);
      });
      const score = chordDifficultyScore(transposed);
      if (score < bestScore) {
        bestScore = score;
        bestCapo = capo;
        bestChords = transposed;
      }
    }

    if (bestCapo > 0 && bestScore < currentScore) {
      const uniqueChords = [...new Set(bestChords)];
      capoHint.textContent = `Capo ${bestCapo}: m\u00E4ngi ${uniqueChords.join(', ')}`;
      capoHint.classList.remove('hidden');
    } else {
      capoHint.classList.add('hidden');
    }
  }

  // ─── Auto-scroll ───
  const scrollBtn = document.getElementById('scroll-btn');
  const scrollPlay = document.getElementById('scroll-play');
  const scrollPause = document.getElementById('scroll-pause');
  const scrollSpeed = document.getElementById('scroll-speed');
  let scrolling = false;
  let scrollRAF = null;
  let lastTime = 0;

  function getScrollPxPerSecond() {
    const speed = parseInt(scrollSpeed.value);
    return 15 + (speed - 1) * 12; // 15px/s to 123px/s
  }

  function scrollStep(timestamp) {
    if (!scrolling) return;
    if (lastTime) {
      const dt = (timestamp - lastTime) / 1000;
      window.scrollBy(0, getScrollPxPerSecond() * dt);

      // Stop at bottom
      if ((window.innerHeight + window.scrollY) >= document.body.scrollHeight - 10) {
        stopScroll();
        return;
      }
    }
    lastTime = timestamp;
    scrollRAF = requestAnimationFrame(scrollStep);
  }

  function startScroll() {
    scrolling = true;
    lastTime = 0;
    scrollPlay.classList.add('hidden');
    scrollPause.classList.remove('hidden');
    scrollSpeed.classList.remove('hidden');
    scrollRAF = requestAnimationFrame(scrollStep);
  }

  function stopScroll() {
    scrolling = false;
    if (scrollRAF) cancelAnimationFrame(scrollRAF);
    scrollPlay.classList.remove('hidden');
    scrollPause.classList.add('hidden');
  }

  scrollBtn.addEventListener('click', () => {
    if (scrolling) stopScroll();
    else startScroll();
  });

  // Save/restore scroll speed
  const savedSpeed = localStorage.getItem('scrollSpeed');
  if (savedSpeed) scrollSpeed.value = savedSpeed;
  scrollSpeed.addEventListener('input', () => {
    localStorage.setItem('scrollSpeed', scrollSpeed.value);
  });

  // Spacebar to toggle scroll
  document.addEventListener('keydown', (e) => {
    if (e.code === 'Space' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'SELECT' && document.activeElement.tagName !== 'TEXTAREA') {
      e.preventDefault();
      if (scrolling) stopScroll();
      else startScroll();
    }
  });

  // ─── Initialize ───
  makechordsClickable();
  updateChordStrip();
  updateCapoHint();
})();
</script>
