---
layout: layout.njk
pagination:
  data: songs
  size: 1
  alias: song
permalink: "laulud/{{ song.slug }}/"
eleventyComputed:
  pageTitle: "{{ song.title }} — Kitarr"
---

<div class="mb-6">
  <a href="/" class="inline-flex items-center gap-1 text-sm text-ctp-overlay1 hover:text-ctp-lavender transition-colors mb-4">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m15 19-7-7 7-7"/></svg>
    Tagasi
  </a>

  <h1 class="text-2xl md:text-3xl font-bold text-ctp-text mb-1">{{ song.song }}</h1>
  {% if song.artist %}
  <p class="text-lg text-ctp-mauve">
{{ song.artist }}
  </p>
  {% endif %}
</div>

<div class="song-sheet relative rounded-xl border border-ctp-surface0 bg-ctp-mantle overflow-hidden">
  <div class="flex items-center justify-between px-4 py-2 border-b border-ctp-surface0 bg-ctp-crust/50">
    <span class="text-xs text-ctp-overlay0 font-medium uppercase tracking-wider">Akordid & s&otilde;nad</span>
    <button id="font-size-toggle" class="text-xs text-ctp-overlay1 hover:text-ctp-text px-2 py-1 rounded transition-colors" title="Muuda fondi suurust">
      aA
    </button>
  </div>
  <pre id="song-content" class="song-pre p-4 md:p-6 overflow-x-auto text-sm md:text-base font-mono leading-relaxed text-ctp-subtext1">{{ song.content }}</pre>
</div>

{% set artistSongs = songs | artistSongs(song.artist) %}
{% if artistSongs.length > 1 %}
<div class="mt-8">
  <h2 class="text-lg font-semibold mb-3 text-ctp-subtext1">Veel artisti {{ song.artist }} laule</h2>
  <ul class="space-y-1">
    {% for s in artistSongs %}
    {% if s.slug !== song.slug %}
    <li>
      <a href="/laulud/{{ s.slug }}/" class="block px-3 py-2 rounded-lg hover:bg-ctp-surface0 text-ctp-subtext0 hover:text-ctp-mauve transition-colors">
        {{ s.song }}
      </a>
    </li>
    {% endif %}
    {% endfor %}
  </ul>
</div>
{% endif %}

<script>
(function() {
  const pre = document.getElementById('song-content');
  const btn = document.getElementById('font-size-toggle');
  const sizes = ['text-xs', 'text-sm', 'text-base', 'text-lg'];
  let current = parseInt(localStorage.getItem('songFontSize') || '1');

  function applySize() {
    sizes.forEach(s => pre.classList.remove(s));
    pre.classList.add(sizes[current]);
    pre.classList.remove('md:text-base', 'md:text-lg', 'md:text-xl');
  }

  btn.addEventListener('click', () => {
    current = (current + 1) % sizes.length;
    localStorage.setItem('songFontSize', current);
    applySize();
  });

  applySize();
})();
</script>
