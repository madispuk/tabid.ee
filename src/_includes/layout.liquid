<!DOCTYPE html>
<html lang="et" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ pageTitle | default: "tabid.ee" }}</title>
  <meta name="description" content="{{ metaDescription | default: 'Eesti laulude akordid ja sõnad kitarrile. Leia oma lemmiklaulu akordid tabid.ee lehelt.' }}">
  <link rel="canonical" href="https://tabid.ee{{ page.url }}">
  <meta property="og:title" content="{{ pageTitle | default: 'tabid.ee' }}">
  <meta property="og:description" content="{{ metaDescription | default: 'Eesti laulude akordid ja sõnad kitarrile. Leia oma lemmiklaulu akordid tabid.ee lehelt.' }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://tabid.ee{{ page.url }}">
  <meta property="og:site_name" content="tabid.ee">
  <meta property="og:locale" content="et_EE">
  <meta property="og:image" content="https://tabid.ee/og-image.jpg">
  <meta property="og:image:width" content="1320">
  <meta property="og:image:height" content="880">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://tabid.ee/og-image.jpg">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48">
  <link rel="apple-touch-icon" href="/favicon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "tabid.ee",
    "url": "https://tabid.ee",
    "description": "Eesti laulude akordid ja sõnad kitarrile",
    "inLanguage": "et",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://tabid.ee/#q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>
</head>
<body class="bg-ctp-base text-ctp-text min-h-screen font-sans flex flex-col">
  <main class="flex-1 max-w-5xl w-full mx-auto px-3 md:px-6 py-8">
    {{ content }}
  </main>

  <footer class="max-w-5xl w-full mx-auto px-4 py-8 border-t border-ctp-surface0">
    <p class="text-sm text-ctp-overlay0 text-center">
      <a href="/privaatsuspoliitika/" class="underline hover:text-ctp-lavender">Privaatsuspoliitika</a>
    </p>
  </footer>
  <script>
    if ('wakeLock' in navigator) {
      let wakeLock = null;
      async function requestWakeLock() {
        try { wakeLock = await navigator.wakeLock.request('screen'); } catch (_) {}
      }
      requestWakeLock();
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') requestWakeLock();
      });
    }
  </script>
</body>
</html>
