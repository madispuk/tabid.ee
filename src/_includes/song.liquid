---
layout: layout.liquid
---
{% assign prevItem = collections.songs | prevSong: slug %}
{% assign nextItem = collections.songs | nextSong: slug %}
{% assign allSlugsJson = collections.songs | allSlugsJson %}

<div class="mb-6">
  <a href="/" class="inline-flex items-center gap-1 text-sm text-ctp-overlay1 hover:text-ctp-lavender transition-colors mb-4">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="m15 19-7-7 7-7"/></svg>
    Tagasi
  </a>

  <h1 class="text-xl sm:text-2xl font-bold mb-1">
    {% if artist %}<a href="/artist/{{ artist | artistSlug }}/" class="text-ctp-mauve hover:underline">{{ artist }}</a><span class="text-ctp-overlay1 font-normal mx-2">–</span>{% endif %}<span class="text-ctp-text">{{ song }}</span>
  </h1>
</div>

{%- comment -%} Chord Summary Strip {%- endcomment -%}
<div id="chord-strip" class="mb-4 hidden">
  <div class="flex flex-wrap items-center gap-y-2 gap-x-2 md:gap-x-4 mb-3">
    <div id="chord-mode-toggle" class="flex rounded-lg border border-ctp-surface0 overflow-hidden">
      <button data-mode="frets" class="chord-mode-btn text-xs font-medium uppercase tracking-wider px-4 py-2 md:px-3 md:py-1 transition-colors bg-ctp-surface0 text-ctp-lavender">Vahed</button>
      <button data-mode="fingers" class="chord-mode-btn text-xs font-medium uppercase tracking-wider px-4 py-2 md:px-3 md:py-1 transition-colors text-ctp-overlay0 hover:text-ctp-text">Sõrmed</button>
    </div>
    <div id="font-size-toggle" class="flex rounded-lg border border-ctp-surface0 overflow-hidden">
      <button data-size="0" class="font-size-btn text-xs font-medium text-ctp-overlay1 hover:text-ctp-text px-3 py-2 md:px-2 md:py-1 transition-colors" title="Väike">S</button>
      <button data-size="1" class="font-size-btn text-xs font-medium text-ctp-overlay1 hover:text-ctp-text px-3 py-2 md:px-2 md:py-1 border-x border-ctp-surface0 transition-colors" title="Keskmine">M</button>
      <button data-size="2" class="font-size-btn text-xs font-medium text-ctp-overlay1 hover:text-ctp-text px-3 py-2 md:px-2 md:py-1 transition-colors" title="Suur">L</button>
    </div>
    <div id="transpose-control" class="flex rounded-lg border border-ctp-surface0 overflow-hidden">
      <button id="transpose-down" class="text-xs font-medium text-ctp-overlay1 hover:text-ctp-text hover:bg-ctp-surface0 px-3 py-2 md:px-2 md:py-1 transition-colors" title="Transponeerida alla">−</button>
      <span id="transpose-value" class="text-xs font-medium text-ctp-subtext1 px-2 py-2 md:py-1 border-x border-ctp-surface0 min-w-[2rem] text-center tabular-nums">0</span>
      <button id="transpose-up" class="text-xs font-medium text-ctp-overlay1 hover:text-ctp-text hover:bg-ctp-surface0 px-3 py-2 md:px-2 md:py-1 transition-colors" title="Transponeerida üles">+</button>
    </div>
    <div class="basis-full sm:hidden"></div>
    <div class="flex rounded-lg border border-ctp-surface0 overflow-hidden">
      {% if prevItem %}<a href="/laulud/{{ prevItem.slug }}/" class="flex items-center gap-1 px-3 py-2 md:px-2 md:py-1 text-xs font-medium text-ctp-overlay1 hover:text-ctp-text hover:bg-ctp-surface0 transition-colors" title="{{ prevItem.artist }} – {{ prevItem.song }}">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m15 19-7-7 7-7"/></svg><span>Eelmine</span>
      </a>{% else %}<span class="flex items-center gap-1 px-3 py-2 md:px-2 md:py-1 text-xs font-medium text-ctp-overlay0 opacity-40 cursor-not-allowed">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m15 19-7-7 7-7"/></svg><span>Eelmine</span>
      </span>{% endif %}{% if nextItem %}<a href="/laulud/{{ nextItem.slug }}/" class="flex items-center gap-1 px-3 py-2 md:px-2 md:py-1 border-l border-ctp-surface0 text-xs font-medium text-ctp-overlay1 hover:text-ctp-text hover:bg-ctp-surface0 transition-colors" title="{{ nextItem.artist }} – {{ nextItem.song }}">
        <span>Järgmine</span><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m9 5 7 7-7 7"/></svg>
      </a>{% else %}<span class="flex items-center gap-1 px-3 py-2 md:px-2 md:py-1 border-l border-ctp-surface0 text-xs font-medium text-ctp-overlay0 opacity-40 cursor-not-allowed">
        <span>Järgmine</span><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m9 5 7 7-7 7"/></svg>
      </span>{% endif %}
    </div>
    <button id="random-btn" data-slugs='{{ allSlugsJson }}' class="flex items-center gap-1.5 text-xs font-medium text-ctp-overlay1 hover:text-ctp-text rounded-lg border border-ctp-surface0 px-3 py-2 md:px-2 md:py-1 hover:bg-ctp-surface0 transition-colors">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 3 21 3 21 8"/><line x1="4" y1="20" x2="21" y2="3"/><polyline points="21 16 21 21 16 21"/><line x1="15" y1="15" x2="21" y2="21"/><line x1="4" y1="4" x2="9" y2="9"/>
      </svg>
      <span>Juhuslik</span>
    </button>
  </div>
  <div id="chord-strip-items" class="flex gap-2 overflow-x-auto pb-2"></div>
</div>

<div class="song-sheet relative rounded-xl border border-ctp-surface0 bg-ctp-mantle overflow-hidden">
  <div class="flex items-center px-4 py-2 border-b border-ctp-surface0 bg-ctp-crust/50">
    <span class="text-xs text-ctp-overlay0 font-medium uppercase tracking-wider">Sõnad & Akordid</span>
  </div>
  <pre id="song-content" class="song-pre p-4 md:p-6 overflow-x-auto text-sm md:text-sm font-mono leading-relaxed text-ctp-subtext1">{{ content }}</pre>
</div>

{% assign artistSongs = collections.songs | artistSongs: artist %}
{% if artistSongs.size > 1 %}
<div class="mt-10">
  <div class="flex items-center gap-2 mb-4">
    <span class="text-xs text-ctp-overlay0 font-medium uppercase tracking-wider">Veel artisti {{ artist }} laule</span>
  </div>
  <div class="flex flex-wrap gap-2">
    {% for s in artistSongs %}
    {% if s.data.slug != slug %}
    <a href="/laulud/{{ s.data.slug }}/" class="rounded-lg border border-ctp-surface0 bg-ctp-mantle px-3 py-1.5 text-xs text-ctp-subtext1 hover:border-ctp-mauve/40 hover:text-ctp-mauve transition-all">
      {{ s.data.song }}
    </a>
    {% endif %}
    {% endfor %}
  </div>
</div>
{% endif %}

{%- comment -%} Chord Popup {%- endcomment -%}
<div id="chord-popup" class="fixed z-50 hidden">
  <div class="bg-ctp-surface0 border border-ctp-surface1 rounded-xl shadow-2xl p-3">
    <div class="mb-2">
      <span id="popup-chord-name" class="text-sm font-bold text-ctp-mauve"></span>
      <span class="text-[10px] text-ctp-overlay0 ml-1">alternatiivid</span>
    </div>
    <div id="popup-voicings" class="flex gap-2 overflow-x-auto pb-1"></div>
    <div class="hidden"><div id="popup-dots"></div></div>
    <button id="popup-close" class="hidden"></button>
  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "MusicComposition",
  "name": "{{ song }}",
  {% if artist %}"composer": { "@type": "MusicGroup", "name": "{{ artist }}" },{% endif %}
  "inLanguage": "et",
  "lyrics": {
    "@type": "CreativeWork",
    "inLanguage": "et"
  },
  "url": "https://tabid.ee/laulud/{{ slug }}/"
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "tabid.ee",
      "item": "https://tabid.ee/"
    }{% if artist %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ artist }}",
      "item": "https://tabid.ee/artist/{{ artist | slugify }}/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": "{{ song }}"
    }{% else %},
    {
      "@type": "ListItem",
      "position": 2,
      "name": "{{ song }}"
    }{% endif %}
  ]
}
</script>
<script src="/js/song-page.js"></script>
<script>
  (function () {
    const btn = document.getElementById("random-btn");
    if (!btn) return;
    const slugs = JSON.parse(btn.dataset.slugs || "[]");
    const current = location.pathname.replace(/^\/laulud\//, "").replace(/\/$/, "");
    btn.addEventListener("click", () => {
      const others = slugs.filter((s) => s !== current);
      if (!others.length) return;
      const pick = others[Math.floor(Math.random() * others.length)];
      location.href = "/laulud/" + pick + "/";
    });
  })();
</script>
