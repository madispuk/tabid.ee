{
  "name": "tabid-ee",
  "version": "1.0.0",
  "description": "Eesti laulude akordid ja sõnad kitarrile",
  "type": "module",
  "scripts": {
    "scrape": "node scrape.mjs",
    "dev:ts": "esbuild src/ts/index-page.ts src/ts/song-page.ts src/ts/lisa-page.ts --outdir=_site/js --bundle --watch",
    "dev:css": "tailwindcss -i src/css/style.css -o _site/css/style.css --watch",
    "dev:11ty": "eleventy --serve",
    "dev": "concurrently npm:dev:*",
    "build:ts": "esbuild src/ts/index-page.ts src/ts/song-page.ts src/ts/lisa-page.ts --outdir=_site/js --bundle --minify",
    "build:css": "tailwindcss -i src/css/style.css -o _site/css/style.css --minify",
    "build:11ty": "eleventy",
    "build": "npm run build:ts && npm run build:css && npm run build:11ty"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/cli": "^4.2.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.4"
  }
}
